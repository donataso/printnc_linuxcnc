o<_manual_tool_change> sub
  #<tool_number> = #1

  (PRINT, Manual tool change requested)
  (PRINT, Current tool: #<_current_tool>)
  (PRINT, New tool: #<tool_number>)
  
  (Move to a safe position before tool change)
  G53 G0 Z0
  G53 G0 X100 Y100
  
  (Trigger the tool change dialog using HAL pin - using correct pin name)
  (DEBUG, HAL_PIN_SET,qtdragon.oktest,1)
  
  (Wait for dialog to complete - check waiting state)
  #<waiting> = 1
  o110 while [#<waiting> GT 0]
    (SLEEP, 0.2)
    (DEBUG, HAL_PIN_GET,qtdragon.oktest-waiting,#<waiting>)
  o110 endwhile
  
  (Reset the trigger pin)
  (DEBUG, HAL_PIN_SET,qtdragon.oktest,0)
  
  (PRINT, Tool change completed)
  
o<_manual_tool_change> endsub
